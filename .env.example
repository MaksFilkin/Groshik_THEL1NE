# Copy to agent.env (chmod 600). Names only — put real values on the server.
# ── required for `python main.py register`
AGENT_OWNER_EMAIL=
# ── defaults shown; change only if needed
THE_LINE_URL=https://api.the1ine.com
AGENT_ENDPOINT_URL=https://agent.the1ine.com
HOST=127.0.0.1
PORT=8001
THE_LINE_KEYDIR=/var/lib/groshik-agent
AGENT_PRICE_USDC=0.05
HEARTBEAT_INTERVAL_S=30
LOG_LEVEL=INFO
# ── optional LLM (without a key: deterministic extractive summarizer)
LLM_PROVIDER=auto
LLM_MODE=hard
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_TIMEOUT_S=20
# ── optional overrides (normally generated/stored in THE_LINE_KEYDIR)
AGENT_WALLET_PK=
AGENT_SIGNING_PRIV=
THE_LINE_AGENT_ID=
THE_LINE_API_KEY=
THE_LINE_TRUSTED_SECRET=
